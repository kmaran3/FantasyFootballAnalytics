# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this-to-a-random-string
FLASK_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///yourdatabase.db

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For production deployment:
# - Generate a strong SECRET_KEY using: python -c "import os; print(os.urandom(32).hex())"
# - Set FLASK_ENV=production
# - Use PostgreSQL: DATABASE_URL=postgresql://user:password@host:port/database
